PORT=3000

# Postgres connection string.
DATABASE_URL=postgresql://scrum_party:scrum_party@localhost:5432/scrum_party

# Better Auth. Generate a long random secret in real environments.
# (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated origins that may call /api/auth/* (in addition to BETTER_AUTH_URL).
# Useful when the deployed URL differs from the canonical one.
BETTER_AUTH_TRUSTED_ORIGINS=

# Credentials for `bun run db:seed` (the only way to create an admin).
# Do NOT commit real values — only set these locally and on the host.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
